# Copy to backend/.env or export in your shell before starting uvicorn.

# --- Security ---
# Without these, the API runs in local demo mode with authentication disabled.
SENTIMENTIQ_AUTH_ENABLED=true
SENTIMENTIQ_ADMIN_USER=admin
SENTIMENTIQ_ADMIN_PASSWORD=change-me
SENTIMENTIQ_SECRET_KEY=replace-with-a-long-random-secret
SENTIMENTIQ_TOKEN_TTL=43200

# --- CORS (comma separated) ---
SENTIMENTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Files & ingestion ---
# Uploads are staged to disk; only small inline JSON payloads go through the API.
SENTIMENTIQ_MAX_FILE_MB=200
SENTIMENTIQ_MAX_RECORDS=250000
SENTIMENTIQ_INLINE_RECORDS=500
SENTIMENTIQ_ANALYZE_LIMIT=100000
SENTIMENTIQ_CHUNK_SIZE=2000
SENTIMENTIQ_INFERENCE_CHUNK=1000
SENTIMENTIQ_MAX_TEXT_LENGTH=4000
SENTIMENTIQ_ALLOWED_DOMAINS=reddit.com,www.reddit.com,old.reddit.com,yelp.com,www.yelp.com,trustpilot.com,www.trustpilot.com,amazon.com,www.amazon.com,youtube.com,www.youtube.com,x.com,twitter.com,www.twitter.com,instagram.com,www.instagram.com,facebook.com,www.facebook.com
SENTIMENTIQ_URL_TIMEOUT=12
SENTIMENTIQ_URL_MAX_BYTES=2097152

# --- Models (real Hugging Face checkpoints) ---
SENTIMENTIQ_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENTIQ_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
SENTIMENTIQ_NLI_MODEL=typeform/distilbert-base-uncased-mnli
SENTIMENTIQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTIMENTIQ_BATCH_SIZE=32
SENTIMENTIQ_MAX_WORKERS=2
# HF_HOME defaults to backend/data/models (absolute, based on the app location).
# Set an absolute path here only if you want a shared cache, e.g.
# HF_HOME=C:/Users/You/.cache/huggingface

# --- Runtime ---
# -1 = CPU, 0 = first CUDA GPU.
SENTIMENTIQ_DEVICE=-1
# Bounded result details for very large runs.
SENTIMENTIQ_MAX_ACCOUNT_SUMMARIES=500
SENTIMENTIQ_TOPIC_FIT_SAMPLE=20000
